# Τα μυστικά του bot. Το αρχείο «.env» μένει ΜΟΝΟ στον υπολογιστή σου: δεν το στέλνεις πουθενά.

# Κλειδί API του PumpPortal (για τη ροή δεδομένων του PumpPortal, που χρεώνεται)
PUMPPORTAL_API_KEY=

# Δωρεάν ροή χωρίς κλειδί και χωρίς SOL: βγάλε το # από την παρακάτω γραμμή
#FEED_URL=wss://pumpdev.io/ws

# Θέμα ntfy για ειδοποιήσεις στο κινητό (προαιρετικό)
NTFY_TOPIC=

# paper = εικονικά χρήματα (προεπιλογή) · live = πραγματικά
MEMEBOT_MODE=paper

# ── Μόνο για πραγματικές συναλλαγές ──
# Ιδιωτικό κλειδί ΞΕΧΩΡΙΣΤΟΥ πορτοφολιού μόνο για το bot (Phantom: Show Private Key)
WALLET_PRIVATE_KEY=
# RPC, π.χ. δωρεάν από helius.dev: https://mainnet.helius-rpc.com/?api-key=...
RPC_URL=
# Μόνο αν live.broker = lightning: η διεύθυνση του πορτοφολιού του PumpPortal
PUMPPORTAL_WALLET_PUBLIC_KEY=
# Γράψε yes μόνο όταν αποφασίσεις συνειδητά να παίξεις πραγματικά χρήματα
MEMEBOT_I_ACCEPT_RISK=no
